# 复制为 .env 后按需修改（服务本身不自动读取 .env，本地调试可用 --env-file）
PORT=3000
DATA_DIR=./storage
# 账号与设置文件，默认放在 DATA_DIR/.users.json（首次启动自动创建管理员）
USERS_FILE=

# 初始管理员：只在账号文件不存在时用来创建第一个管理员，之后改密码请用网页后台
ADMIN_USER=xujunyao
ADMIN_PASSWORD=shenye128

# 线上务必替换成随机串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=512

# 部署在 https 域名上时设为 true
COOKIE_SECURE=false
